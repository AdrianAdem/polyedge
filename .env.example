# Polymarket
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYGON_PRIVATE_KEY=

# Binance (read-only)
BINANCE_API_KEY=
BINANCE_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# FRED
FRED_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading
PAPER_TRADING=true
INITIAL_BALANCE=500
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_RISK=0.02
HARD_STOP_LOSS=0.004

# Scanner
SCAN_INTERVAL_SECONDS=300
MIN_MARKET_VOLUME=50000
MIN_EDGE_THRESHOLD=0.10
MIN_CONFIDENCE_THRESHOLD=0.70
# Cost cap: max markets analyzed per scan (each costs one Haiku call)
MAX_MARKETS_PER_SCAN=40

# Storage (override in Docker: /app/db/polyedge.db)
DB_PATH=polyedge.db
